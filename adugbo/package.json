{
  "name": "adugbo-street-kings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ADUGBO: Street Kings \u2014 a browser 3D Nigerian street-football game (three.js + Rapier).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "inspect:assets": "node tools/inspect-assets.mjs",
    "test:e2e": "npm run build && node tests/e2e/lab.e2e.mjs && node tests/e2e/practice.e2e.mjs && node tests/e2e/venue.e2e.mjs && node tests/e2e/match.e2e.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
